# Redpanda (Kafka)
REDPANDA_BOOTSTRAP_SERVERS=localhost:9092
REDPANDA_SCHEMA_REGISTRY=http://localhost:8081

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medallion
MINIO_SECURE=false

# DuckDB
DUCKDB_PATH=data/medallion.duckdb

# Iceberg
ICEBERG_WAREHOUSE=s3://medallion/iceberg/

# Dagster
DAGSTER_HOME=/opt/dagster

# App
LOG_LEVEL=INFO
